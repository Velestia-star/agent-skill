{
  "name": "dsh-agent-skill",
  "version": "0.2.0",
  "description": "Agent & Skill: a sidebar panel for building your own subagents and skills, then calling any subagent by name in a conversation. Each subagent picks its model, reasoning effort, spawn/fork launch mode, tool allowlist and skill bundle; each skill is an ordinary SKILL.md you place globally or per workspace, down to individual conversations. · 智能体与技能：在侧栏里自己造子智能体与技能，并在对话中按名字调用；子智能体可配模型、思考强度、spawn/fork 启动方式、工具清单与技能，技能可放全局、按工作区甚至按单个对话生效。",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/host.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "subagent",
    "agent",
    "skill",
    "delegation",
    "sidebar"
  ],
  "license": "MIT",
  "author": "Velestia-star",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Velestia-star/agent-skill.git"
  },
  "bugs": {
    "url": "https://github.com/Velestia-star/agent-skill/issues"
  },
  "homepage": "https://github.com/Velestia-star/agent-skill#readme",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
